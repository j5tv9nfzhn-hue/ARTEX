# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 可选：公开仓库读取 Release 不需要令牌；仅在限流或仓库转私有后需要
# （仅后端读取；令牌需 j5tv9nfzhn-hue/ARTEX 的 Contents: read）
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
